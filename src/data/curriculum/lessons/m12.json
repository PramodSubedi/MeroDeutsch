  "traps": [
    {
      "note": {
        "en": "Trap 1: Conjugating the end verb in a modal sentence",
        "ne": "मोडल वाक्यमा अन्त्यको क्रियालाई संयोजित गर्नु",
        "de": "Das Endverb im Modalsatz konjugieren"
      },
      "wrong": "Falsch: \"Ich kann Deutsch spreche.\"",
      "right": "Richtig: \"Ich kann Deutsch SPRECHEN.\" (End verb MUST be infinitive!)."
    },
    {
      "note": {
        "en": "Trap 2: Adding -t ending to ich or er/sie/es on modals",
        "ne": "मोडलहरूमा ich वा er/sie/es मा -t ending थप्नु",
        "de": "-t Endung zu ich oder er/sie/es bei Modalverben hinzufügen"
      },
      "wrong": "Falsch: \"Er kannt Deutsch.\" / \"Ich musst lernen.\"",
      "right": "Richtig: \"Er kann Deutsch.\" / \"Ich muss lernen.\""
    },
    {
      "note": {
        "en": "Trap 3: Confusing müssen (must) and nicht dürfen (must NOT) — Ich muss nicht: \"I don't have to\" (optional). Ich darf nicht: \"I am NOT allowed to / forbidden\" (prohibited!).",
        "ne": "müssen (पर्छ) र nicht dürfen (पर्न हुँदैन) बीच भ्रम — Ich muss nicht: \"मैले गर्नु पर्दैन\" (वैकल्पिक)। Ich darf nicht: \"मैले गर्न अनुमति छैन / मनाही\" (निषिद्ध!)।",
        "de": "müssen (müssen) und nicht dürfen (nicht dürfen) verwechseln — Ich muss nicht: \"Ich muss nicht\" (optional). Ich darf nicht: \"Ich darf nicht\" (verboten!)."
      }
    }
  ],
