  "grammar": [
    {
      "title": {
        "en": "The Pain Construction: weh tun (to hurt / ache)",
        "de": "The Pain Construction: weh tun (to hurt / ache)"
      },
      "notes": [
        {
          "en": "In German, pain is expressed using the verb weh tun with Dative pronouns (mir, dir, ihm, ihr, Ihnen): German Pain Expression Formula: [BODY PART] + \"tut\" (singular) / \"tun\" (plural) + \"weh\" Examples: • Mein Kopf TUT weh. (Singular: 'Kopf' -> tut) • Meine Augen TUN weh. (Plural: 'Augen' -> tun) • Mein Rücken TUT mir weh. (Literally: My back does pain to me)",
          "ne": "",
          "de": ""
        }
      ]
    },
    {
      "title": {
        "en": "Compound Nouns with -schmerzen",
        "de": "Compound Nouns with -schmerzen"
      },
      "notes": [
        {
          "en": "Body parts combine with -schmerzen (plural) to form pain nouns: ---",
          "ne": "",
          "de": ""
        }
      ],
      "bullets": [
        "Kopf + Schmerzen \\(\\rightarrow\\) die Kopfschmerzen (headache)",
        "Bauch + Schmerzen \\(\\rightarrow\\) die Bauchschmerzen (stomach ache)",
        "Rücken + Schmerzen \\(\\rightarrow\\) die Rückenschmerzen (back pain)",
        "Zahn + Schmerzen \\(\\rightarrow\\) die Zahnschmerzen (toothache)"
      ]
    }
  ],
  "dialogue": {
    "id": "m14-dialogue",
    "title": {
