  "grammar": [
    {
      "title": {
        "en": "Transportation Preposition: mit (+ Dative Case)",
        "de": "Transportation Preposition: mit (+ Dative Case)"
      },
      "notes": [
        {
          "en": "The preposition mit ALWAYS triggers the Dative case:",
          "ne": "",
          "de": ""
        }
      ],
      "bullets": [
        "Masculine (der Bus/Zug): mit dem Bus / mit dem Zug",
        "Neuter (das Auto/Taxi): mit dem Auto / mit dem Taxi",
        "Feminine (die Bahn/U-Bahn): mit der Bahn / mit der U-Bahn"
      ]
    },
    {
      "title": {
        "en": "Giving & Asking for Directions",
        "de": "Giving & Asking for Directions"
      },
      "bullets": [
        "Asking: Entschuldigung, wie komme ich zum Bahnhof?",
        "Commands (Imperative Formal):",
        "Gehen Sie geradeaus. (\"Go straight ahead.\")",
        "Biegen Sie links / rechts ab. (\"Turn left / right.\")",
        "Nehmen Sie die erste Straße rechts. (\"Take the first street on the right.\")"
      ]
    }
  ],
