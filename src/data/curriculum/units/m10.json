  "pedagogy": {
    "ruleTable": {
      "title": {
        "en": "Akkusativ",
        "de": "Akkusativ"
      },
      "rows": [
        {
          "label": {
            "en": "der → den",
            "de": "der → den"
          },
          "usage": {
            "en": "masculine direct object",
            "de": "männliches Objekt"
          },
          "example": {
            "en": "Ich sehe den Mann.",
            "de": "Ich sehe den Mann."
          }
        },
        {
          "label": {
            "en": "ein → einen",
            "de": "ein → einen"
          },
          "usage": {
            "en": "masculine, no article",
            "de": "männlich, ohne Artikel"
          },
          "example": {
            "en": "Ich esse einen Apfel.",
            "de": "Ich esse einen Apfel."
          }
        },
        {
          "label": {
            "en": "kein → keinen",
            "de": "kein → keinen"
          },
          "usage": {
            "en": "negated masculine",
            "de": "verneintes Maskulinum"
          },
          "example": {
            "en": "Ich habe keinen Stuhl.",
            "de": "Ich habe keinen Stuhl."
          }
        },
        {
          "label": {
            "en": "die / das → same",
            "de": "die / das → gleich"
          },
          "usage": {
            "en": "feminine, neuter, plural",
            "de": "Feminin, Neutrum, Plural"
          },
          "example": {
            "en": "Ich trinke das Wasser.",
            "de": "Ich trinke das Wasser."
          }
        }
      ]
    },
    "grammarNote": {
      "en": "Only MASCULINE articles change in the accusative: der → den, ein → einen, kein → keinen. Feminine, neuter and plural stay the same.",
      "de": "Nur MASKULINE Artikel ändern sich im Akkusativ: der → den, ein → einen, kein → keinen. Feminin, Neutrum und Plural bleiben gleich."
    }
  },
  "vocabCategories": [
