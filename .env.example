# Supabase Configuration
# Get these values from your Supabase project dashboard:
# Settings > API > Project URL and anon/public key

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenAI API key for the Phase 1.2 enrichment script (scripts/enrich-cards.ts).
# Set locally and never commit a real key. Run: npm run enrich
OPENAI_API_KEY=
