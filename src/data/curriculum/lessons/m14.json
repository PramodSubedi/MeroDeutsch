    "turns": [
      {
        "speaker": "Arzt:",
        "de": "Guten Tag, Herr Gurung! Was fehlt Ihnen?"
      },
      {
        "speaker": "Patient:",
        "de": "Guten Tag, Herr Doktor. Mein Kopf tut sehr weh und ich habe Fieber."
      },
      {
        "speaker": "Arzt:",
        "de": "Seit wann haben Sie das?"
      },
      {
        "speaker": "Patient:",
        "de": "Seit gestern Abend."
      },
      {
        "speaker": "Arzt:",
        "de": "Ich untersuche Sie. Nehmen Sie diese Tabletten drei Tage lang. Sie sollen viel Wasser trinken und im Bett bleiben."
      },
      {
        "speaker": "Patient:",
        "de": "Vielen Dank, Herr Doktor!"
      }
    ]
  },
