  "pedagogy": {
    "ruleTable": {
      "title": {
        "en": "Directional prepositions",
        "de": "Richtungspräpositionen"
      },
      "rows": [
        {
          "label": {
            "en": "nach",
            "de": "nach"
          },
          "usage": {
            "en": "cities, countries, directions",
            "de": "Städte, Länder, Richtungen"
          },
          "example": {
            "en": "nach links, nach Berlin",
            "de": "nach links, nach Berlin"
          }
        },
        {
          "label": {
            "en": "zu / zum / zur",
            "de": "zu / zum / zur"
          },
          "usage": {
            "en": "specific places, people",
            "de": "bestimmte Orte, Personen"
          },
          "example": {
            "en": "zum Bahnhof, zur Schule",
            "de": "zum Bahnhof, zur Schule"
          }
        },
        {
          "label": {
            "en": "in / ins",
            "de": "in / ins"
          },
          "usage": {
            "en": "inside a building",
            "de": "in ein Gebäude hinein"
          },
          "example": {
            "en": "ins Kaufhaus",
            "de": "ins Kaufhaus"
          }
        }
      ]
    },
    "grammarNote": {
      "en": "In formal instructions the verb leads and Sie follows immediately: Gehen Sie geradeaus! Fahren Sie nach links!",
      "de": "In formellen Anweisungen steht das Verb vorn, Sie folgt sofort: Gehen Sie geradeaus! Fahren Sie nach links!"
    }
  },
