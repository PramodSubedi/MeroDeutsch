  "grammar": [
    {
      "title": {
        "en": "Stem-Changing Verbs (du & er/sie/es)",
        "de": "Stem-Changing Verbs (du & er/sie/es)"
      },
      "notes": [
        {
          "en": "Vowels change ONLY in 2nd (du) and 3rd (er/sie/es) person singular:",
          "ne": "",
          "de": ""
        }
      ],
      "bullets": [
        "e -> i / ie:",
        "lesen: ich lese, du liest, er liest, wir lesen",
        "essen: ich esse, du isst, er isst, wir essen",
        "a -> ä:",
        "fahren: ich fahre, du fährst, er fährt, wir fahren",
        "schlafen: ich schlafe, du schläfst, er schläft, wir schlafen"
      ]
    },
    {
      "title": {
        "en": "The Golden V2 Word Order Rule",
        "de": "The Golden V2 Word Order Rule"
      },
      "notes": [
