  "grammar": [
    {
      "title": {
        "en": "Demonstrative Articles (dieser / diese / dieses)",
        "de": "Demonstrativartikel (dieser / diese / dieses)"
      },
      "notes": [
        {
          "en": "Demonstratives take the same endings as definite articles (der/die/das). In the accusative, only the masculine form changes (dieser → diesen). Feminine, neuter, and plural remain unchanged.",
          "ne": "Demonstrativeहरू निश्चित articles (der/die/das) जस्तै endings लिन्छन्। Accusative मा मात्र पुरुषलिङ्ग (masculine) रूप परिवर्तित हुन्छ (dieser → diesen)। स्त्रीलिङ्ग, नपुंसकलिङ्ग, र बहुवचन अपरिवर्तित रहन्छन्।",
          "de": "Demonstrativa nehmen die gleichen Endungen wie bestimmte Artikel (der/die/das). Im Akkusativ ändert sich nur die männliche Form (dieser → diesen). Feminin, Neutrum und Plural bleiben unverändert."
        }
      ],
      "table": {
        "columns": [
          "Gender",
          "Nominative",
          "Accusative",
          "Example (Nom)",
          "Example (Acc)"
        ],
        "rows": [
          [
            "Masculine (der)",
            "dieser",
            "diesen",
            "dieser Pullover",
            "diesen Pullover"
          ],
          [
            "Feminine (die)",
            "diese",
            "diese",
            "diese Hose",
            "diese Hose"
          ],
          [
            "Neuter (das)",
            "dieses",
            "dieses",
            "dieses Hemd",
            "dieses Hemd"
          ],
          [
            "Plural (die)",
            "diese",
            "diese",
            "diese Schuhe",
            "diese Schuhe"
          ]
        ]
      }
    },
    {
      "title": {
        "en": "Asking About Size & Expressing Preferences",
        "de": "Nach Größe fragen & Vorlieben äußern"
      },
      "notes": [
        {
          "en": "Asking size: 'Welche Größe haben Sie?' → 'Ich habe Größe M / 38.' Preference verbs: 'gefallen' takes dative (Mir gefällt...), 'passen' for fit. Adjectives after sein/bleiben/werden take NO ending: 'Das Hemd ist rot' (not 'rote').",
          "ne": "साइज सोध्ने: 'Welche Größe haben Sie?' → 'Ich habe Größe M / 38.' पसन्दका क्रियाहरू: 'gefallen' ले dative लिन्छ (Mir gefällt...), 'passen' फिटका लागि। sein/bleiben/werden पछिको adjectives ले कुनै ending लिदैनन्: 'Das Hemd ist rot' (नकी 'rote')।",
          "de": "Größe fragen: 'Welche Größe haben Sie?' → 'Ich habe Größe M / 38.' Präferenzverben: 'gefallen' nimmt Dativ (Mir gefällt...), 'passen' für Passform. Adjektive nach sein/bleiben/werden haben KEINE Endung: 'Das Hemd ist rot' (nicht 'rote')."
        }
      ],
      "bullets": [
        "Welche Größe haben Sie? → Ich habe Größe M / 38.",
        "Wie gefällt dir diese Jacke? → Sie gefällt mir sehr gut!",
        "Das Hemd ist rot. (KEIN -e am Adjektiv nach sein!)"
      ]
    }
  ],
