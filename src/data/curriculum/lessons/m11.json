      "notes": [
        {
          "en": "Demonstratives take the same endings as definite articles (der/die/das):",
          "ne": "",
          "de": ""
        }
      ],
      "bullets": [
        "Masculine (der): dieser Pullover (Nominative) -> diesen Pullover (Accusative)",
