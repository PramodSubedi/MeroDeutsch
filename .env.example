# Supabase Configuration
# Get these values from your Supabase project dashboard:
# Settings > API > Project URL and anon/public key

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Admin control center (admin.merodeutsch.pramods.com.np) ──────────────────
# The admin app is a SECOND ENTRY in the same repo and shares the two values
# above — same Supabase project, no separate backend. These are only used by
# the admin bundle to label its own origin and to build cross-app links.
#
# Set BOTH on BOTH Vercel projects (learner + admin). They are compiled into
# the bundle, so a project missing one silently falls back to the sibling-
# subdomain derivation in `debugModeLink.ts` / `qaBridge.ts` — which works, but
# fails SILENTLY when wrong: a bad VITE_APP_URL opens the QA tab on the wrong
# origin and the bridge just reports "not connected" with no error to trace.
#
#   VITE_APP_URL   = https://merodeutsch.pramods.com.np
#   VITE_ADMIN_URL = https://admin.merodeutsch.pramods.com.np
#
# Leave both EMPTY for local dev: the loopback branches then resolve the
# control centre to a same-origin /admin.html, which is what lets the whole QA
# flow run on one Vite dev server with no configuration.
#
# NOTE: do NOT add a per-subdomain "cookie domain" here. The session is stored
# in localStorage by supabase-js, which is already partitioned per origin, so
# isolation comes from the subdomain split itself. The trade-off is that an
# admin signs in once per origin — there is no cookie to share.
VITE_APP_URL=
VITE_ADMIN_URL=

# Live-DB management (scripts/runSql.ts → Management API, the same endpoint the
# Dashboard SQL Editor uses). Create a Personal Access Token at:
#   https://supabase.com/dashboard/account/tokens
# and scope it to the project's organization. Keep it out of git (it lives in
# .env.local). Optional since scripts/runSql.ts defaults to the project ref.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=uiwlioriubixerspdamx

