  "grammar": [
    {
      "title": {
        "en": "Special German Characters",
        "de": "Special German Characters"
      },
      "bullets": [
        "Ä / ä = /ɛ/ (like English \"e\" in bed). Example: spät.",
        "Ö / ö = /ø/ (say \"eh\" with rounded lips). Example: schön.",
        "Ü / ü = /y/ (say \"ee\" with rounded lips). Example: über.",
        "ß (Eszett) = /s/ (sharp 's' after long vowels). Example: groß."
      ]
    },
    {
      "title": {
        "en": "German Diphthongs",
        "de": "German Diphthongs"
      },
      "bullets": [
        "ei = \"eye\" (mein, heißen) | ie = \"ee\" (sie, wie)",
        "eu / äu = \"oy\" (deutsch, Häuser) | au = \"ow\" (Haus, Frau)"
      ]
    }
  ],
