  "pedagogy": {
    "grammarNotes": [
      "Regular verbs: remove -en, add -e/-st/-t/-en/-t/-en",
      "Stem-changing verbs (e→i/ie, a→ä) affect ONLY du and er/sie/es",
      "sein (bin/bist/ist/sind/seid/sind) and haben (habe/hast/hat/haben/habt/haben) are highly irregular"
    ],
    "ruleTables": [
      {
        "title": {
          "en": "Regular Verb Endings",
          "de": "Regelmäßige Verbendungen"
        },
        "columns": ["Pronoun", "Ending", "wohnen", "lernen", "machen"],
        "rows": [
          ["ich", "-e", "wohne", "lerne", "mache"],
          ["du", "-st", "wohnst", "lernst", "machst"],
          ["er/sie/es", "-t", "wohnt", "lernt", "macht"],
          ["wir", "-en", "wohnen", "lernen", "machen"],
          ["ihr", "-t", "wohnt", "lernt", "macht"],
          ["sie/Sie", "-en", "wohnen", "lernen", "machen"]
        ]
      },
      {
        "title": {
          "en": "Stem-Changing Verbs (du/er/sie/es only)",
          "de": "Stammwechsel-Verben (nur du/er/sie/es)"
        },
        "columns": ["Pattern", "Infinitive", "ich", "du", "er/sie/es", "wir"],
        "rows": [
          ["e → i", "geben", "gebe", "gibst", "gibt", "geben"],
          ["e → ie", "lesen", "lese", "liest", "liest", "lesen"],
          ["e → ie", "sehen", "sehe", "siehst", "sieht", "sehen"],
          ["e → i", "essen", "esse", "isst", "isst", "essen"],
          ["a → ä", "fahren", "fahre", "fährst", "fährt", "fahren"],
          ["a → ä", "schlafen", "schlafe", "schläfst", "schläft", "schlafen"]
        ]
      },
      {
        "title": {
          "en": "Irregular Verbs: sein & haben",
          "de": "Unregelmäßige Verben: sein & haben"
        },
        "columns": ["Pronoun", "sein", "haben"],
        "rows": [
          ["ich", "bin", "habe"],
          ["du", "bist", "hast"],
          ["er/sie/es", "ist", "hat"],
          ["wir", "sind", "haben"],
          ["ihr", "seid", "habt"],
          ["sie/Sie", "sind", "haben"]
