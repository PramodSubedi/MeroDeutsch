  "grammar": [
    {
      "title": {
        "en": "Social Register: du vs. Sie",
        "de": "Social Register: du vs. Sie"
      },
      "bullets": [
        "Informal (du): Used with friends, family, children, fellow students. (Nepali: तिमी)",
        "Formal (Sie): Used with strangers, elders, professionals, officials. Always capitalized. (Nepali: तपाईं)"
      ]
    },
    {
      "title": {
        "en": "Core Verb Conjugations (Present Tense)",
        "de": "Core Verb Conjugations (Present Tense)"
      },
      "bullets": [
        "kommen (stem: komm-): ich komme, du kommst, er/sie/es kommt, wir kommen, ihr kommt, Sie/sie kommen",
        "heißen (stem: heiß-): ich heiße, du heißt, er/sie/es heißt, wir heißen, ihr heißt, Sie/sie heißen"
      ]
    },
    {
      "title": {
        "en": "Question Formation: W-Questions vs. Yes/No Questions",
        "de": "Question Formation: W-Questions vs. Yes/No Questions"
      },
      "bullets": [
        "W-Question (Verb in Position 2): Woher kommen Sie? / Wie heißen Sie?",
        "Yes/No Question (Verb in Position 1): Sprechen Sie Deutsch? / Wohnst du in Berlin?"
      ]
    }
  ],
