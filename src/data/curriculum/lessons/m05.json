          "de": ""
        }
      ],
      "table": {
        "columns": [
          "Target Negated",
          "Correct Negation Word",
          "Example Sentence (DE)",
          "Translation (EN)"
        ],
        "rows": [
          [
            "Noun with indefinite article (ein Tisch)",
            "kein / keine",
            "Ich habe keinen Tisch.",
            "I have no table."
          ],
          [
            "Noun with no article (Geld / Zeit)",
            "kein / keine",
            "Ich habe kein Geld.",
            "I have no money."
          ],
          [
            "Adjective (groß / alt)",
            "nicht",
            "Das Zimmer ist nicht groß.",
            "The room is not big."
          ],
          [
            "Verb (schlafen / kommen)",
            "nicht",
            "Er schläft nicht.",
            "He is not sleeping."
          ],
          [
            "Specific Noun with definite article (der Schlüssel)",
