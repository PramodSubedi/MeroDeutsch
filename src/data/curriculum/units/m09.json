  "pedagogy": {
    "grammarNotes": [
      "Separable verbs = prefix + base verb (auf|stehen, ein|kaufen, an|rufen)",
      "In main clauses: base verb conjugates to Position 2, prefix jumps to VERY END (Satzklammer)",
      "Common separable prefixes: auf-, ab-, an-, aus-, ein-, mit-, fern-, vor-, zurück-",
      "Inseparable prefixes (ver-, be-, ge-, ent-, er-, emp-, miss-, zer-) NEVER split"
    ],
    "ruleTables": [
      {
        "title": {
          "en": "Satzklammer (Sentence Bracket) Structure",
          "de": "Satzklammer-Struktur"
        },
        "columns": ["Pos 1", "Pos 2 (Verb)", "Middle", "END (Prefix)"],
        "rows": [
          ["Ich", "stehe", "jeden Morgen um 6 Uhr", "auf."],
          ["Wir", "kaufen", "heute im Supermarkt", "ein."],
          ["Er", "ruft", "seine Mutter", "an."],
          ["Das Fest", "fängt", "um 20 Uhr", "an."],
          ["Räumst", "du", "bitte dein Zimmer", "auf?"]
        ]
      },
      {
        "title": {
          "en": "Key Separable Verbs for Daily Routines",
          "de": "Wichtige trennbare Verben für Tagesabläufe"
        },
        "columns": ["Verb", "Prefix|Base", "Meaning", "Example"],
        "rows": [
          ["aufstehen", "auf|stehen", "get up", "Ich stehe um 7 Uhr auf."],
          ["einkaufen", "ein|kaufen", "shop", "Am Samstag kaufe ich ein."],
          ["anrufen", "an|rufen", "call", "Ich rufe dich an."],
          ["fernsehen", "fern|sehen", "watch TV", "Wir sehen abends fern."],
          ["ankommen", "an|kommen", "arrive", "Der Zug kommt um 14 Uhr an."],
          ["abfahren", "ab|fahren", "depart", "Der Bus fährt um 8 Uhr ab."],
          ["anfangen", "an|fangen", "begin", "Der Kurs fängt um 9 Uhr an."],
          ["ausmachen", "aus|machen", "turn off", "Er macht das Licht aus."],
          ["anmachen", "an|machen", "turn on", "Mach bitte die Heizung an."],
          ["aufhören", "auf|hören", "stop", "Der Regen hört auf."],
          ["vorbereiten", "vor|bereiten", "prepare", "Wir bereiten das Essen vor."],
          ["aufräumen", "auf|räumen", "tidy up", "Ich räume das Zimmer auf."]
