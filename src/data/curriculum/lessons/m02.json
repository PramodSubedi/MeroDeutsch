  "grammar": [
    {
      "title": {
        "en": "The German Unit-Inversion Rule (21 to 99)",
        "de": "The German Unit-Inversion Rule (21 to 99)"
      },
      "notes": [
        {
          "en": "Units come FIRST, followed by und, then tens:",
          "ne": "",
          "de": ""
        }
      ],
      "bullets": [
        "21: ein + und + zwanzig = einundzwanzig",
        "35: fünf + und + dreißig = fünfunddreißig",
        "48: acht + und + vierzig = achtundvierzig"
      ]
    },
