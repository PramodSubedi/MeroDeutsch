  "grammar": [
    {
      "title": {
        "en": "Mechanics of Separable Verbs (Trennbare Verben)",
        "de": "Mechanics of Separable Verben (Trennbare Verben)"
      },
      "notes": [
        {
          "en": "A separable verb is a prefix plus a base verb. In a main clause the base verb is conjugated and takes Position 2, and the prefix detaches and travels to the very end of the sentence. This is the Satzklammer, the sentence bracket.",
          "ne": "ट्रण्डरने क्रिया पूर्वसर्ग र आधारभूत क्रियाबाट बन्छ। मुख्य वाक्यमा आधारभूत क्रिया संयोजित हुन्छ र स्थान २ मा जान्छ, र पूर्वसर्ग अन्त्यमा चल्छ। यहीलाई Satzklammer (वाक्य कोष्ठक) भनिन्छ।",
          "de": "Ein trennbares Verb ist ein Präfix plus ein Basisverb. Im Hauptsatz wird das Basisverb konjugiert und steht auf Position 2, während das Präfix sich löst und ganz ans Satzende geht. Das ist die Satzklammer, der Satz-Klammer."
        }
      ],
      "table": {
        "columns": [
          "Pos 1",
          "Pos 2 (Verb)",
          "Middle",
          "END (Prefix)"
        ],
        "rows": [
          [
            "Ich",
            "stehe",
            "jeden Morgen um 6 Uhr",
            "auf."
          ],
          [
            "Wir",
            "kaufen",
            "heute im Supermarkt",
            "ein."
          ],
          [
