  "grammar": [
    {
      "title": {
        "en": "Forming Female Professions (-in Suffix)",
        "de": "Forming Female Professions (-in Suffix)"
      },
      "notes": [
        {
          "en": "In German, female job titles add the suffix -in (and often add an umlaut to root vowels):",
          "ne": "",
          "de": ""
        }
      ],
      "bullets": [
        "der Lehrer -> die Lehrerin",
        "der Arzt -> die Ärztin",
        "der Student -> die Studentin",
        "Plural female suffix: -innen (die Lehrerinnen)"
      ]
    },
    {
      "title": {
        "en": "Stating Your Profession: \"als\" & \"bei\"",
        "de": "Stating Your Profession: \"als\" & \"bei\""
      },
      "bullets": [
        "Use als for job titles: Ich arbeite als Ingenieur. / Ich bin als Arzt tätig.",
        "Use bei (+ Dative) for companies: Ich arbeite bei Siemens.",
        "Note: Do NOT use articles before job titles when using sein or werden: Ich bin Arzt. (NOT: Ich bin ein Arzt.)"
      ]
    }
  ],
