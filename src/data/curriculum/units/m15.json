  "pedagogy": {
    "ruleTable": {
      "title": {
        "en": "Das Perfekt",
        "de": "Das Perfekt"
      },
      "rows": [
        {
          "label": {
            "en": "haben + Partizip II",
            "de": "haben + Partizip II"
          },
          "usage": {
            "en": "most verbs",
            "de": "die meisten Verben"
          },
          "example": {
            "en": "Ich habe Fußball gespielt.",
            "de": "Ich habe Fußball gespielt."
          }
        },
        {
          "label": {
            "en": "sein + Partizip II",
            "de": "sein + Partizip II"
          },
          "usage": {
            "en": "movement / change of place",
            "de": "Bewegung und Ortswechsel"
          },
          "example": {
            "en": "Ich bin nach Hause gegangen.",
            "de": "Ich bin nach Hause gegangen."
          }
        },
        {
          "label": {
            "en": "ge- … -t",
            "de": "ge- … -t"
          },
          "usage": {
            "en": "regular (weak) verbs",
            "de": "regelmäßige Verben"
          },
          "example": {
            "en": "spielen → gespielt",
            "de": "spielen → gespielt"
          }
        },
        {
          "label": {
            "en": "ge- … -en",
            "de": "ge- … -en"
          },
          "usage": {
            "en": "strong verbs, vowel may change",
            "de": "starke Verben, Vokal wechselt"
          },
          "example": {
            "en": "scheinen → geschienen",
            "de": "scheinen → geschienen"
          }
        }
      ]
    },
    "grammarNote": {
      "en": "The spoken past tense is a two-part frame: the auxiliary (haben or sein) in position two, the Partizip II at the very end. Use sein for movement.",
      "de": "Das gesprochene Perfekt ist ein Zweiteil: das Hilfsverb (haben/sein) an Position zwei, das Partizip II ganz am Ende. Für Bewegung nimmt man sein."
    }
  },
  "vocabCategories": [
