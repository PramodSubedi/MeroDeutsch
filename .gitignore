# Seeding-pipeline staging data (kept local, not app code).
# NOTE: `scripts/data/*` (contents), not `scripts/data/` (the directory itself) —
# git never descends into an excluded directory, so a deeper negation could never
# re-include anything.
src/data/vocab/
scripts/data/*
# …except the curriculum regression fixture, which MUST be committed: a fresh
# clone needs `baseline.json` for `npm run curriculum:verify` to have anything to
# compare the data-driven spine against. See scripts/data/a1-curriculum/README.md.
!scripts/data/a1-curriculum/
# The two frozen copies of the pre-P0 source stay local (100 KB of dead code is
# not worth versioning; the README explains how to recreate them).
scripts/data/a1-curriculum/_legacy.ts
scripts/data/a1-curriculum/_pre-p0-a1Path.ts.bak

# One-off AI-generated migration/DB artifacts (local only)
MIGRATION-GUIDE.md
local-german-db.json
scripts/create-local-db.cjs
scripts/enrich-local.ts
scripts/populate-local-db.cjs

# Cleanup archive (moved-out docs/plans/logs/strays/intermediates - local only)
_archive/

# Dev-server stderr redirect (vite writes transform errors here; never commit)
dev.err
dev.log
*.log

# NOTE: `ADMIN_PHASES_HANDOFF.md` is DELIBERATELY TRACKED, not ignored.
# It is the only written record of which files another agent owns, why the
# boot-gate is needed, and that a secret has to be set by hand. A previous
# revision ignored it here — twice, in fact — which did nothing (gitignore has
# no effect on a tracked file) but read as an intent to untrack the continuity
# record. If you ever mean to untrack it, that is a decision to state out loud
# in a commit message, not a line to leave lying around in this file.
supabase/.temp/cli-latest
ADMIN_PHASES_HANDOFF.md
