  "grammar": [
    {
      "title": {
        "en": "The Accusative Case Direct Object Shift (Akkusativ)",
        "de": "The Accusative Case Direct Object Shift (Akkusativ)"
      },
      "notes": [
        {
          "en": "In German, the direct object receiving the action of a verb takes the Accusative Case. Accusative Article Shift Matrix: ┌────────────┬───────────────────┬───────────────────┬───────────────────┐ │ Gender │ Nominative │ Accusative (Def) │ Accusative Indef. │ ├────────────┼───────────────────┼───────────────────┼───────────────────┤ │ Masculine │ der Tisch │ DEN Tisch │ EINEN Tisch │ │ Feminine │ die Suppe │ DIE Suppe │ EINE Suppe │ │ Neuter │ das Brot │ DAS Brot │ EIN Brot │ │ Plural │ die Äpfel │ DIE Äpfel │ - Äpfel │ └────────────┴───────────────────┴───────────────────┴───────────────────┘ Verbs that ALWAYS take Accusative direct objects: bestellen (to order), trinken (to drink), essen (to eat), haben (to have), kaufen (to buy), brauchen (to need), sehen (to see), möchten (would like). Examples: ---",
          "ne": "",
          "de": ""
        }
      ],
      "callout": "🚨 CRITICAL ACCUSATIVE RULE: ONLY *Masculine (der) articles shift in Accusative! Feminine (die), Neuter (das), and Plural (die*) remain 100% UNCHANGED!",
      "bullets": [
        "Ich habe EINEN Kaffee. (Masculine: der Kaffee \\(\\rightarrow\\) einen).",
        "Ich esse EIN Brot. (Neuter: das Brot \\(\\rightarrow\\) ein - unchanged).",
        "Ich bestelle EINE Suppe. (Feminine: die Suppe \\(\\rightarrow\\) eine - unchanged)."
      ]
    },
    {
      "title": {
        "en": "Accusative Triggers",
        "de": "Accusative Triggers"
      },
      "notes": [
        {
          "en": "Verbs that ALWAYS take Accusative direct objects: bestellen (to order), trinken (to drink), essen (to eat), haben (to have), kaufen (to buy), brauchen (to need), sehen (to see), möchten (would like). Examples: ---",
          "ne": "",
          "de": ""
        }
      ],
      "bullets": [
        "Ich habe EINEN Kaffee. (Masculine: der Kaffee \\(\\rightarrow\\) einen).",
        "Ich esse EIN Brot. (Neuter: das Brot \\(\\rightarrow\\) ein - unchanged).",
        "Ich bestelle EINE Suppe. (Feminine: die Suppe \\(\\rightarrow\\) eine - unchanged)."
      ]
    }
