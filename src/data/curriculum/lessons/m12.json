  "grammar": [
    {
      "title": {
        "en": "Modal Verb Conjugation (Present Tense)",
        "de": "Modalverb-Konjugation (Präsens)"
      },
      "notes": [
        {
          "en": "Modal verbs drop umlauts in singular forms (ich, du, er/sie/es) and have matching 1st & 3rd person singular forms (ich and er/sie/es share the SAME form with NO ending).",
          "ne": "मोडल क्रियाहरू एकवचनमा (ich, du, er/sie/es) umlauts बिर्साउँछन् र १ र ३ पुरुष एकवचन (ich र er/sie/es) को रूपै मिल्छ (कुनै ending छैन)।",
          "de": "Modalverben verlieren Umlaute in Singularformen (ich, du, er/sie/es) und haben identische 1. & 3. Person Singular (ich und er/sie/es teilen die GLEICHE Form OHNE Endung)."
        }
      ],
      "table": {
        "columns": [
          "Pronoun",
          "können (can)",
          "müssen (must)",
          "wollen (want)",
          "dürfen (may)",
          "sollen (should)",
