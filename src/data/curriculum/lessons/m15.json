  "grammar": [
    {
      "title": {
        "en": "Introduction to Past Tense (Perfekt)",
        "de": "Introduction to Past Tense (Perfekt)"
      },
      "notes": [
        {
          "en": "The Present Perfect (Perfekt) is used in spoken German for past events. It consists of two parts: Auxiliary Verb (haben or sein) in Pos 2 + Past Participle (Partizip II) at Very End.",
          "ne": "",
          "de": ""
        }
      ]
    },
    {
      "title": {
        "en": "Auxiliary Selection Rule",
        "de": "Auxiliary Selection Rule"
      },
      "bullets": [
        "Use sein for verbs of motion or change of state: kommen, fahren, gehen.",
        "Ich bin gestern nach Berlin gefahren.",
        "Use haben for all other verbs (transitive / stationary): machen, kaufen, lernen, spielen.",
        "Ich habe am Wochenende Fußball gespielt."
      ]
    },
    {
      "title": {
        "en": "Regular Partizip II Rule: ge- + stem + -t",
        "de": "Regular Partizip II Rule: ge- + stem + -t"
      },
      "bullets": [
        "machen -> gemacht | lernen -> gelernt | kaufen -> gekauft"
      ]
    }
  ],
